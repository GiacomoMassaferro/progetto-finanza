# Ambiente di esecuzione: development | production | test
NODE_ENV="development"

# Porta HTTP dell'API Express
PORT="3000"

# URL usata dalla Prisma CLI per migration, introspezione e Prisma Studio.
# Formato: mysql://UTENTE:PASSWORD@INDIRIZZO_DB:PORTA_DB/NOME_DB
DATABASE_URL="mysql://user:password@localhost:3306/express_finance"

# URL dello shadow database (deve esistere ed essere vuoto).
# La CLI lo usa per rieseguire le migration e confrontarle con il database reale.
SHADOW_DATABASE_URL="mysql://user:password@localhost:3306/express_finance_shadow"

# Parametri usati a runtime dall'adapter MariaDB in src/config/prisma.js.
# Devono descrivere lo stesso database di DATABASE_URL.
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="express_finance"

# SSL verso il DB ("true" in produzione con certificati validi).
# In locale resta "false": il connettore mariadb con SSL attivo
# si blocca in handshake contro MySQL senza certificati.
DATABASE_SSL="false"

# URL del frontend autorizzata dal CORS (default Vite in sviluppo).
# In produzione impostare l'URL reale (es. "https://app.example.com").
FRONTEND_URL="http://localhost:5173"

# Segreto di firma JWT (genera il tuo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
JWT_SECRET="cambia-questo-segreto-in-produzione"

# Chiave Gemini personale (da Google AI Studio; mai committare quella vera).
GEMINI_API_KEY="incolla-qui-la-tua-chiave"
GEMINI_MODEL="gemini-3.8-flash"
