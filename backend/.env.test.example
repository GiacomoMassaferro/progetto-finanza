# Template per l'ambiente di test delle migrazioni.
# Copia in .env.test e sostituisci i valori; .env.test è gitignored.
# Il DATABASE_NAME (e le URL) devono terminare con _test: il wrapper
# scripts/prisma-test.js rifiuta di eseguire comandi su altri database.

NODE_ENV="test"
PORT="3001"

DATABASE_URL="mysql://UTENTE:PASSWORD@localhost:3306/express_finance_test"
SHADOW_DATABASE_URL="mysql://UTENTE:PASSWORD@localhost:3306/express_finance_test_shadow"

DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="UTENTE"
DATABASE_PASSWORD="PASSWORD"
DATABASE_NAME="express_finance_test"

DATABASE_SSL="false"
FRONTEND_URL="http://localhost:5173"

# Cookie di sessione: in test niente Secure (le suite girano su http).
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Genera un segreto dedicato:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="SOSTITUISCI-CON-UN-SEGRETO-CASUALE-DI-ALMENO-32-CARATTERI"

# Vuota = l'ambiente di test non chiama Gemini (nessuna quota consumata).
GEMINI_API_KEY=""
